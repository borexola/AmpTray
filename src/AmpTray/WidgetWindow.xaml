<Window x:Class="AmpTray.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmpTray"
        Title="AmpTray"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Typography.NumeralAlignment="Tabular"
        Foreground="{DynamicResource TextPrimary}">

    <!-- All visible text is assigned in code (ApplyLanguage) so it can be translated. -->
    <Grid Margin="10">
        <Border x:Name="Panel"
                Width="292"
                CornerRadius="12"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" />
            </Border.Effect>

            <Grid>
                <StackPanel Margin="14,12,14,12">
                    <!-- GPU temperatures (NVIDIA); shown whenever an NVIDIA GPU is present -->
                    <Grid x:Name="GpuStrip" Visibility="Collapsed" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GpuName" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:ArcGauge x:Name="GpuGauge" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="GPU" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="GpuTempText" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="GpuMemTempLabel" Text="MEM" FontSize="10" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="10,0,4,0" />
                            <TextBlock x:Name="GpuMemTempText" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="GpuStripDivider" Style="{StaticResource Divider}" Margin="0,0,0,10" Visibility="Collapsed" />

                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,1,8,0" Fill="{DynamicResource IdleBrush}" />
                            <TextBlock Text="WIREVIEW PRO II" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            <Border x:Name="RecBadge" Visibility="Collapsed" Margin="8,0,0,0" Padding="5,0,5,1"
                                    CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource CritBrush}">
                                <TextBlock Text="REC" FontSize="9" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Border x:Name="ArmedBadge" Visibility="Collapsed" Margin="6,0,0,0" Padding="5,0,5,1"
                                    CornerRadius="4" VerticalAlignment="Center" BorderThickness="1"
                                    BorderBrush="{DynamicResource WarnBrush}">
                                <TextBlock x:Name="ArmedText" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" Opacity="0" Visibility="Collapsed"
                                    VerticalAlignment="Top" Margin="0,0,6,0">
                            <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Content="&#xE740;" />
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" />
                        </StackPanel>

                        <TextBlock x:Name="TotalPower" Grid.Column="2" Text="n/a" FontSize="22" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Right" />

                        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="2" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" />
                        <TextBlock x:Name="TotalCurrent" Grid.Row="1" Grid.Column="2" Text="" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" Margin="0,-2,0,0" />
                    </Grid>

                    <!-- Fault alert banner -->
                    <Border x:Name="AlertBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,7,7,7"
                            CornerRadius="8" Background="{DynamicResource CritBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AlertText" Foreground="White" FontWeight="Bold" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button x:Name="AckButton" Grid.Column="1" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                                    Background="#33FFFFFF" Foreground="White" />
                        </Grid>
                    </Border>

                    <!-- Auto-shutdown pending banner -->
                    <Border x:Name="ShutdownBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,7,7,7"
                            CornerRadius="8" Background="{DynamicResource WarnBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ShutdownText" Foreground="#1A1A1A" FontWeight="SemiBold" FontSize="11.5"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button x:Name="ShutdownCancelButton" Grid.Column="1" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                                    Background="#26000000" Foreground="#1A1A1A" />
                        </Grid>
                    </Border>

                    <!-- New release available (dismissable until next launch) -->
                    <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,7,4,7"
                            CornerRadius="8" Background="{DynamicResource GraphBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpdateText" Foreground="#0B1620" FontWeight="SemiBold" FontSize="11.5"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button x:Name="UpdateDownloadButton" Grid.Column="1" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                                    Background="#26000000" Foreground="#0B1620" />
                            <Button x:Name="UpdateDismissButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                    FontSize="9" Foreground="#0B1620" Margin="2,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Wires -->
                    <StackPanel x:Name="WiresSection">
                        <Border Style="{StaticResource Divider}" />
                        <Grid>
                            <TextBlock x:Name="WiresLabel" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="ScaleText" HorizontalAlignment="Right" Style="{StaticResource SectionLabel}"
                                       Foreground="{DynamicResource TextMuted}" FontWeight="Normal" />
                        </Grid>
                        <Grid x:Name="PinHeader" Visibility="Collapsed" Margin="0,0,0,2" />
                        <StackPanel x:Name="PinRows" />
                        <TextBlock x:Name="SpreadText" FontSize="10.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Temperatures -->
                    <StackPanel x:Name="TempsSection">
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock x:Name="TempsLabel" Style="{StaticResource SectionLabel}" />
                        <UniformGrid x:Name="TempGrid" Columns="4" Rows="1" />
                    </StackPanel>

                    <!-- GPU -->
                    <StackPanel x:Name="GpuSection">
                        <Border Style="{StaticResource Divider}" />
                        <Grid>
                            <TextBlock x:Name="GpuLabel" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="GpuClockText" HorizontalAlignment="Right" Style="{StaticResource SectionLabel}"
                                       Foreground="{DynamicResource TextMuted}" FontWeight="Normal" />
                        </Grid>
                        <TextBlock x:Name="GpuNone" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                        <StackPanel x:Name="GpuBars" />
                        <WrapPanel x:Name="GpuThrottle" Margin="0,4,0,0" />
                        <Grid x:Name="GpuDetails" Visibility="Collapsed" Margin="0,8,0,0" />
                        <TextBlock x:Name="GpuPowerPath" Visibility="Collapsed" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock x:Name="GpuSession" Visibility="Collapsed" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>

                    <!-- Power graph -->
                    <StackPanel x:Name="GraphSection">
                        <Border Style="{StaticResource Divider}" />
                        <Grid>
                            <TextBlock x:Name="PowerLabel" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="GraphStatsText" HorizontalAlignment="Right" Style="{StaticResource SectionLabel}"
                                       Foreground="{DynamicResource TextMuted}" FontWeight="Normal" />
                        </Grid>
                        <local:PowerGraph x:Name="Graph" Height="64" />
                        <Grid x:Name="SessionRow" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock x:Name="SessionText" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                            <Button x:Name="ResetStatsButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Faults -->
                    <StackPanel x:Name="FaultsSection">
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock x:Name="FaultsLabel" Style="{StaticResource SectionLabel}" />
                        <WrapPanel x:Name="FaultPanel" />
                        <Grid x:Name="FaultTable" Visibility="Collapsed" />
                        <StackPanel x:Name="FaultEvents" Visibility="Collapsed" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Red pulse layer for fault alerts -->
                <Border x:Name="FlashLayer" CornerRadius="12" Background="{DynamicResource CritBrush}"
                        Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
