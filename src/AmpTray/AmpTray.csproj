<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AmpTray</AssemblyName>
    <RootNamespace>AmpTray</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <StartupObject>AmpTray.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Reproducible output with no build-machine paths baked into the binaries. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Overridden by build.ps1 / CI with -p:Version=... -->
    <Version>0.0.2</Version>
    <Product>AmpTray for WireView Pro II</Product>
    <AssemblyTitle>AmpTray</AssemblyTitle>
    <Authors>borexola</Authors>
    <Company>borexola</Company>
    <Copyright>Copyright © borexola</Copyright>
    <Description>Unofficial read-only desktop widget for the Thermal Grizzly WireView Pro II, with NVIDIA GPU stats. Not affiliated with or endorsed by Thermal Grizzly or NVIDIA.</Description>
    <RepositoryUrl>https://github.com/borexola/AmpTray</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.18" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings\*.json" />
  </ItemGroup>

</Project>
